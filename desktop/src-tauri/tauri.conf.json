{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Formal Mind",
  "version": "0.1.0",
  "identifier": "team.formal.desktop",
  "build": {
    "beforeDevCommand": "bunx vite --config vite.config.mts",
    "beforeBuildCommand": "bunx vite build --config vite.config.mts",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Formal Mind", "width": 1280, "height": 820, "minWidth": 800, "minHeight": 560 }],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["formalmind"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
