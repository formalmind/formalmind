{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Formal Mind",
  "version": "0.1.3",
  "identifier": "team.formal.desktop",
  "build": {
    "beforeDevCommand": "bunx vite --config vite.config.mts",
    "beforeBuildCommand": "bunx vite build --config vite.config.mts",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Formal Mind",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "formalmind"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4Q0Q3NzU1QjgzQ0Q2RTkKUldUcDFqeTRWWGZOQ1BFSFFBTWRVZzJYVXpVc0lQMVpOZUZycEhYSkZJUDJ4cWxlc1QvNFRWV2oK",
      "endpoints": [
        "https://github.com/formalmind/formalmind/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "dmg": {
        "background": "dmg-background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      },
      "signingIdentity": "Developer ID Application: Asyncswap Labs, Inc. (WA3Q5YSLK6)"
    }
  }
}
