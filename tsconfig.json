{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "bun"],
    "paths": {
      "@/*": ["./*"],
      "@formalmind/ui/*": ["./packages/ui/formalmind/*", "./desktop/src/ui-fallback/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", ".open-next", ".next", ".wrangler", "packages/ui/blocks", "packages/ui/screens", "packages/ui/motion", "packages/ui/illustrations", "packages/ui/components"]
}
