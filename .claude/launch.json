{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8787"
      ],
      "port": 8787
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "storybook",
        "dev",
        "-p",
        "6006",
        "--no-open"
      ],
      "port": 6006
    }
  ]
}