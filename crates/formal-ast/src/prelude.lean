/-! Generated by formal-ast from solc's AST: the shared semantics every generated model uses.

  A contract function is `M State α`: it reads the call's environment, reads and writes storage, and can revert.
  Words are `Nat`s; checked arithmetic reverts exactly where Solidity 0.8 panics, `unchecked` wraps. -/

namespace FormalAst

structure Revert where
  reason : String
deriving Repr, BEq

/-- What a call sees: `msg.sender`, `msg.value`, `block.timestamp`, `address(this)`, and so on. -/
structure Env where
  sender : Nat := 0
  value : Nat := 0
  timestamp : Nat := 0
  number : Nat := 0
  self : Nat := 0
  balance : Nat := 0
  chainid : Nat := 0
  origin : Nat := 0
deriving Inhabited

abbrev M (σ α : Type) := ReaderT Env (StateT σ (Except Revert)) α

def panic (code : String) : Revert := ⟨"panic " ++ code⟩

section
variable {σ : Type}

def addc (bits a b : Nat) : M σ Nat :=
  if a + b < 2 ^ bits then pure (a + b) else throw (panic "0x11")
def subc (a b : Nat) : M σ Nat :=
  if b ≤ a then pure (a - b) else throw (panic "0x11")
def mulc (bits a b : Nat) : M σ Nat :=
  if a * b < 2 ^ bits then pure (a * b) else throw (panic "0x11")
def divc (a b : Nat) : M σ Nat :=
  if b = 0 then throw (panic "0x12") else pure (a / b)
def modc (a b : Nat) : M σ Nat :=
  if b = 0 then throw (panic "0x12") else pure (a % b)
def powc (bits a b : Nat) : M σ Nat :=
  if a ^ b < 2 ^ bits then pure (a ^ b) else throw (panic "0x11")

def addw (bits a b : Nat) : Nat := (a + b) % 2 ^ bits
def subw (bits a b : Nat) : Nat := (a + 2 ^ bits - b % 2 ^ bits) % 2 ^ bits
def mulw (bits a b : Nat) : Nat := (a * b) % 2 ^ bits
def divw (a b : Nat) : Nat := if b = 0 then 0 else a / b
def shlw (bits a b : Nat) : Nat := (a <<< b) % 2 ^ bits

/-- OpenZeppelin `Math.mulDiv(x, y, d)`: floor, reverts when `d = 0` or the result doesn't fit 256 bits. -/
def mulDivFloor (x y d : Nat) : M σ Nat :=
  if d = 0 then throw (panic "0x12")
  else if x * y / d < 2 ^ 256 then pure (x * y / d)
  else throw ⟨"MathOverflowedMulDiv"⟩

/-- Rounding up: the floor result plus one when there is a remainder (checked). -/
def mulDivCeil (x y d : Nat) : M σ Nat := do
  let q ← mulDivFloor x y d
  if x * y % d = 0 then pure q else addc 256 q 1

/-- `Math.mulDiv(x, y, d, rounding)`: OpenZeppelin rounds up for Ceil (1) and Expand (3). -/
def mulDivRnd (x y d r : Nat) : M σ Nat :=
  if r % 2 = 1 then mulDivCeil x y d else mulDivFloor x y d

def require (c : Bool) (reason : String) : M σ Unit :=
  if c then pure () else throw ⟨reason⟩

/-- A view call: it sees the environment and our storage, and can't change it. -/
def view {α : Type} (f : Env → σ → Except Revert α) : M σ α := do
  let e ← read
  let s ← get
  match f e s with
  | .ok v => pure v
  | .error r => throw r

def upd {β : Type} (f : Nat → β) (k : Nat) (v : β) : Nat → β := fun x => if x = k then v else f x

def idx {α : Type} [Inhabited α] (l : List α) (i : Nat) : M σ α :=
  if h : i < l.length then pure (l[i]'h) else throw (panic "0x32")
def setAt {α : Type} (l : List α) (i : Nat) (v : α) : List α := l.set i v
def pop {α : Type} (l : List α) : M σ (List α) :=
  if l.isEmpty then throw (panic "0x31") else pure l.dropLast

end

theorem upd_same {β : Type} (f : Nat → β) (k : Nat) (v : β) : upd f k v k = v := by simp [upd]
theorem upd_other {β : Type} (f : Nat → β) (k x : Nat) (v : β) (h : x ≠ k) : upd f k v x = f x := by simp [upd, h]

end FormalAst
