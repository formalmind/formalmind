{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Formal Mind",
  "version": "0.1.0",
  "identifier": "team.formal.mobile",
  "build": {
    "beforeDevCommand": "bunx vite --config vite.config.mts",
    "beforeBuildCommand": "bunx vite build --config vite.config.mts",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Formal Mind" }],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["formalmind"], "appLink": false }]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "iOS": {
      "developmentTeam": "WA3Q5YSLK6",
      "minimumSystemVersion": "17.0"
    }
  }
}
