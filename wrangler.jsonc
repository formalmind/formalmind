{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "formalmind",
	"account_id": "02ef45ae7d46e3f90ae8852d99f111b3",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// The Vite build. Unknown paths get index.html (the app routes them). Every request wakes the Worker first: it
	// answers the agent discovery paths (robots.txt, sitemap.xml, llms.txt, /.well-known/*, /mcp; worker/discovery.ts),
	// serves markdown to clients that prefer it, adds the Link, Content-Signal and Vary headers to HTML, keeps a missing
	// chunk a 404 rather than index.html, and otherwise hands the request to the asset store.
	"assets": {
		"directory": "dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	// The production domain. workers.dev and preview URLs stay on as well (wrangler turns them off
	// once a route exists unless they are set explicitly).
	"routes": [
		{ "pattern": "formal.team", "custom_domain": true },
		// The guide (content/docs/): the same Worker and build, the docs at the root (worker/docs.ts, components/docs/).
		{ "pattern": "docs.formal.team", "custom_domain": true }
	],
	// The guide's pages are imported as text (worker/docs.ts).
	"rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
	"workers_dev": true,
	"preview_urls": true,
	// The "Formal Mind" OAuth App people sign in with (public); its secret is GITHUB_CLIENT_SECRET.
	"vars": { "GITHUB_CLIENT_ID": "Ov23liK0RilXoojDmXW1" },
	"observability": {
		"enabled": true
	},
	// Onboarding drafts, credit balances and applied Stripe payments (lib/kv.ts).
	"kv_namespaces": [
		{ "binding": "FORMALMIND", "id": "9d16b5c66b4645cb9ac59e8b1d81d0c8" }
	],
	// Users (migrations/): `wrangler d1 migrations apply formalmind-users --remote`.
	// One Durable Object per project (worker/project-do.ts): spend now; lease, queue and dispatcher later.
	// One per person (worker/relay-do.ts): the swarm relay between the Mac app and the MCP.
	"durable_objects": {
		"bindings": [
			{ "name": "RELAY", "class_name": "RelayDO" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ProjectDO"] },
		{ "tag": "v2", "new_sqlite_classes": ["RelayDO"] },
		// The old GitHub-issue swarm's spend ledger.
		{ "tag": "v3", "deleted_classes": ["ProjectDO"] }
	],
	"d1_databases": [
		{ "binding": "DB", "database_name": "formalmind-users", "database_id": "cf9ae3bf-c762-4aa3-bd81-b7b50273e689" }
	]
	// Secrets (set with `npx wrangler secret put <NAME>`, or `.dev.vars` for local preview):
	//   OPENAI_API_KEY, GITHUB_CLIENT_SECRET (the formalmind App's client secret, for sign-in), APP_BASE_URL,
	//   GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET, GITHUB_TOKEN,
	//   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, GITHUB_MARKETPLACE_WEBHOOK_SECRET
}
